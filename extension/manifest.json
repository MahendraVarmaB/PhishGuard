{
  "manifest_version": 3,
  "name": "PhishGuard",
  "version": "2.0",
  "description": "Real-time ML-powered phishing URL detection.",
  "permissions": [
    "activeTab",
    "webNavigation",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PhishGuard Status"
  },
  "web_accessible_resources": [
    {
      "resources": ["block.html", "block.js", "styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
